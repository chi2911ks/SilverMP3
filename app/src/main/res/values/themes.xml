<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SilverMP3" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item> <!-- nền app bar -->
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item> <!-- variant tối hơn -->
        <item name="colorOnPrimary">@color/white</item> <!-- chữ trên primary -->
        <!-- Màu phụ (Secondary / Accent) -->
        <item name="colorSecondary">@color/colorSecondary</item> <!-- accent màu xanh ngọc -->
        <item name="colorSecondaryVariant">@color/colorSecondaryVariant</item> <!-- variant màu xanh ngọc -->
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorOnBackground">@color/white</item>
        <item name="colorSurface">@color/colorSurface</item>        <!-- card / bottom nav -->
        <item name="colorOnSurface">@color/white</item>
        <item name="colorControlActivated">@color/colorPrimary</item>

        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColorHint">@color/white</item>
        <item name="android:textCursorDrawable">@null</item>


    </style>

</resources>