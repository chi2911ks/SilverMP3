<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/swipeRefreshLayout"
    tools:context=".ui.home.HomeFragment">
   <androidx.constraintlayout.widget.ConstraintLayout
       android:layout_width="match_parent"
       android:layout_height="match_parent"
       android:padding="10dp">
       <TextView
           android:id="@+id/textView9"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text="Sliver MP3"
           android:textSize="20sp"
           android:textStyle="bold"
           app:layout_constraintBottom_toBottomOf="@+id/moreBtn"
           app:layout_constraintStart_toStartOf="parent"
           app:layout_constraintTop_toTopOf="@+id/moreBtn" />
       <ImageButton
           android:id="@+id/moreBtn"
           android:layout_width="35dp"
           android:layout_height="35dp"
           android:background="@drawable/button_blur"
           android:src="@drawable/ic_profile"
           app:layout_constraintEnd_toEndOf="parent"
           app:layout_constraintTop_toTopOf="parent" />

       <ProgressBar
           android:id="@+id/processSong"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:indeterminateTint="@color/white"
           android:visibility="gone"
           app:layout_constraintBottom_toBottomOf="@+id/linearLayout"
           app:layout_constraintEnd_toEndOf="@+id/linearLayout"
           app:layout_constraintStart_toStartOf="@+id/linearLayout"
           app:layout_constraintTop_toTopOf="@+id/linearLayout" />
       <LinearLayout
           android:id="@+id/linearLayout"
           android:layout_width="0dp"
           android:layout_height="wrap_content"
           android:layout_marginTop="20dp"
           android:orientation="vertical"
           app:layout_constraintEnd_toEndOf="parent"
           app:layout_constraintStart_toStartOf="parent"
           app:layout_constraintTop_toBottomOf="@+id/textView9" >
           <TextView
               android:id="@+id/header_title_rcv"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginBottom="10dp"
               android:text="Bắt đầu nghe"
               android:textStyle="bold"
               android:textSize="18sp"/>
           <androidx.recyclerview.widget.RecyclerView
               android:id="@+id/rvSongs"
               android:layout_width="match_parent"
               android:layout_height="match_parent"/>
       </LinearLayout>
       <LinearLayout
           android:id="@+id/linearLayout2"
           android:layout_width="0dp"
           android:layout_height="wrap_content"
           android:layout_marginTop="20dp"
           android:orientation="vertical"
           app:layout_constraintEnd_toEndOf="parent"
           app:layout_constraintStart_toStartOf="parent"
           app:layout_constraintTop_toBottomOf="@+id/linearLayout" >
           <TextView
               android:id="@+id/header_title_rcv2"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginBottom="10dp"
               android:text="Đề xuất hôm nay"
               android:textStyle="bold"
               android:textSize="18sp"/>
           <androidx.recyclerview.widget.RecyclerView
               android:id="@+id/rvPlaylists"
               android:layout_width="match_parent"
               android:layout_height="match_parent"/>
       </LinearLayout>

   </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>