<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="OtpEdit">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">20sp</item>
        <item name="android:inputType">number</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:background">@drawable/otp_bg</item>
    </style>
    <style name="ButtonPrimary" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">55dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:backgroundTint">@android:color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">25dp</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">24dp</item>
        <item name="iconTint">@color/white</item>
        <item name="rippleColor">@color/ripple_light</item>
    </style>
    <style name="ButtonBottomSheet" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">55dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="background">@null</item>
        <item name="backgroundTint">@color/dark</item>
        <item name="borderWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="cornerRadius">0dp</item>
        <item name="iconPadding">20dp</item>
        <item name="iconSize">24dp</item>
        <item name="iconTint">@color/white</item>
        <item name="rippleColor">@color/ripple_light</item>
    </style>
    <style name="CircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="RoundedCornerImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10%</item>
    </style>

    <style name="CustomSeekBarDark" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressDrawable">@drawable/seekbar_dark_style</item>
        <item name="android:thumb">@drawable/seekbar_dark_thumb</item>
        <item name="android:thumbTint">@android:color/white</item>
        <item name="android:progressTint">@android:color/white</item>
        <item name="android:progressBackgroundTint">#424242</item>
    </style>
    <style name="FullScreenDialogStyle" parent="Theme.SilverMP3">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowIsFloating">false</item>
    </style>


</resources>