<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.auth.login.fragment.LoginMethodFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageButton
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:id="@+id/backBtn"
            android:layout_marginTop="35dp"
            android:background="@drawable/outline_arrow_back_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.04"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <!-- Logo -->
        <ImageView
            android:id="@+id/appLogo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="48dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_logo"
            app:layout_constraintWidth_percent="0.5"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Đăng nhập vào \n Silver MP3"
            android:textSize="36sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@+id/appLogo"
            app:layout_constraintStart_toStartOf="@+id/appLogo"
            app:layout_constraintTop_toBottomOf="@+id/appLogo" />

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="25dp"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.google.android.material.button.MaterialButton
                style="@style/ButtonPrimary"
                android:id="@+id/emailLoginBtn"
                android:backgroundTint="@color/blue_400"
                android:text="Tiếp tục với email"
                android:textColor="@color/white"
                app:icon="@drawable/email" />

            <com.google.android.material.button.MaterialButton
                style="@style/ButtonPrimary"
                android:id="@+id/phoneLoginBtn"
                android:text="Tiếp tục bằng số điện thoại"
                app:icon="@drawable/ic_phone"
                app:iconTint="@color/black" />

            <com.google.android.material.button.MaterialButton
                style="@style/ButtonPrimary"
                android:id="@+id/googleLoginBtn"
                android:text="Tiếp tục bằng Google"
                app:icon="@drawable/ic_google"
                app:iconTint="@null" />

            <com.google.android.material.button.MaterialButton
                style="@style/ButtonPrimary"
                android:id="@+id/fbLoginBtn"
                android:backgroundTint="@android:color/white"
                android:text="Tiếp tục bằng Facebook"
                app:icon="@drawable/ic_fb"
                app:iconTint="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="5dp"
                android:text="Bạn chưa có tài khoản?" />

            <TextView
                android:id="@+id/registerBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="5dp"
                android:clickable="true"
                android:focusable="true"
                android:text="Đăng ký"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


</FrameLayout>